    "bumpp": "catalog:release",
    "changelogithub": "catalog:release",
    "diff": "catalog:testing",
    "eslint": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "fake-indexeddb": "catalog:",
    "h3": "catalog:",
    "immer": "catalog:testing",
    "jsdom": "catalog:testing",
    "pathe": "catalog:utils",
    "playwright": "catalog:testing",
    "postcss": "catalog:build",
    "publint": "catalog:cli",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "react-test-renderer": "catalog:native",
    "shiki": "catalog:testing",
    "simple-icons": "catalog:testing",
    "ssh2": "catalog:utils",
    "tailwindcss": "catalog:build",
    "tsx": "catalog:build",
    "typescript": "catalog:cli",
    "vite": "catalog:build",
    "vitest": "catalog:testing",
    "zod": "catalog:utils",
    "zustand": "catalog:testing"
  }
}
