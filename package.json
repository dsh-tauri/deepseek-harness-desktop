{
  "name": "deepseek-harness-desktop",
  "type": "module",
  "version": "0.22.4",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "Desktop application for DeepSeek Harness (dsh) — one-click local install and launch, no Node.js setup required.",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "pnpm dev:plugins & tauri dev",
    "dev:plugins": "pnpm --filter \"./packages/*\" -r --parallel run dev",
    "prebuild": "pnpm build:plugins",
    "build": "tsc && vite build",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "build:taiwindcss": "tsx packages/dsh-tauri-ui/scripts/taiwindcss.ts",
    "build:debug": "tsx scripts/build-debug.ts",
    "genapi": "genapi",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "bumpp --pr",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:e2e:plugin": "vitest --project plugin",
    "test:e2e:desktop": "vitest --project desktop",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "icons": "tauri icon public/deepseek-harness-desktop-tauri.svg --output src-tauri/icons && tauri icon public/deepseek-harness-desktop-tauri-nightly.svg --output src-tauri/icons/nightly --ios-color \"#000000\" && tsx scripts/rebuild-macos-icon.ts"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-notifications-api": "catalog:",
    "@genapi/pipeline": "catalog:",
    "@gravity-ui/icons": "catalog:runtime",
    "@heroui/react": "catalog:runtime",
    "@heroui/styles": "catalog:runtime",
    "@overlastic/react": "catalog:runtime",
    "@reause/core": "catalog:runtime",
    "@tanstack/react-query": "catalog:runtime",
    "@tauri-apps/api": "catalog:tauri",
    "@tauri-apps/plugin-http": "catalog:tauri",
    "@tauri-apps/plugin-os": "catalog:",
    "@tauri-apps/plugin-store": "catalog:",
    "dsh-pet-component": "catalog:runtime",
    "i18next": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "react-i18next": "catalog:runtime",
    "react-if-lite": "catalog:runtime",
    "semver": "catalog:runtime",
    "tailwind-variants": "catalog:runtime",
    "unstorage": "catalog:utils",
    "valtio-define": "catalog:runtime"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/cordis-plugin-group": "catalog:dsh",
    "@deepseek-ai/cordis-plugin-include": "catalog:dsh",
    "@deepseek-ai/cordis-plugin-loader": "catalog:dsh",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-agent-default-model": "catalog:dsh",
    "@deepseek-ai/dsh-agent-preset": "catalog:dsh",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:dsh",
    "@deepseek-ai/dsh-api-session-controller": "catalog:dsh",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-store": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-permission-presets": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-skill-filesystem": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/dsh-user-approval": "catalog:dsh",
    "@deepseek-ai/dsh-workspace": "catalog:dsh",
    "@eslint-react/eslint-plugin": "catalog:lint",
    "@genapi/core": "catalog:",
    "@genapi/presets": "catalog:",
    "@genapi/shared": "catalog:",
    "@tailwindcss/postcss": "catalog:build",
    "@tailwindcss/vite": "catalog:build",
    "@tauri-apps/cli": "catalog:tauri",
    "@testing-library/dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@types/semver": "catalog:types",
    "@types/ssh2": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "@vitest/coverage-v8": "catalog:testing",
    "@wdio/tauri-service": "catalog:testing",
    "babel-plugin-react-compiler": "catalog:build",
    "bumpp": "catalog:release",
    "changelogithub": "catalog:release",
    "dsh-h3": "catalog:",
    "eslint": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "h3": "catalog:",
    "jsdom": "catalog:testing",
    "pathe": "catalog:utils",
    "playwright": "catalog:testing",
    "postcss": "catalog:build",
    "publint": "catalog:cli",
    "ssh2": "catalog:utils",
    "tailwindcss": "catalog:build",
    "tsx": "catalog:build",
    "typescript": "catalog:cli",
    "vite": "catalog:build",
    "vitest": "catalog:testing",
    "webdriverio": "catalog:testing"
  }
}
