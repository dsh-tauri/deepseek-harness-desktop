{
  "name": "dsh-native",
  "type": "module",
  "version": "0.30.0-alpha.4",
  "private": true,
  "main": "./src/entry.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --output-dir ../../.temp/native-android-export",
    "build:ios": "expo export --platform ios --output-dir ../../.temp/native-ios-export",
    "prebuild": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "test": "vitest run --config ../../config/vitest.native.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "catalog:native",
    "@reause/core": "catalog:runtime",
    "@tanstack/react-query": "catalog:runtime",
    "expo": "catalog:native",
    "expo-blur": "catalog:native",
    "expo-build-properties": "catalog:native",
    "expo-camera": "catalog:native",
    "expo-constants": "catalog:native",
    "expo-crypto": "catalog:native",
    "expo-dev-client": "catalog:native",
    "expo-font": "catalog:native",
    "expo-linking": "catalog:native",
    "expo-localization": "catalog:native",
    "expo-network": "catalog:native",
    "expo-notifications": "catalog:native",
    "expo-router": "catalog:native",
    "expo-secure-store": "catalog:native",
    "expo-splash-screen": "catalog:native",
    "expo-status-bar": "catalog:native",
    "expo-system-ui": "catalog:native",
    "heroui-native": "catalog:native",
    "i18next": "catalog:runtime",
    "react": "catalog:runtime",
    "react-i18next": "catalog:runtime",
    "react-if-lite": "catalog:runtime",
    "react-native": "catalog:native",
    "react-native-drawer-layout": "catalog:native",
    "react-native-gesture-handler": "catalog:native",
    "react-native-lucide": "catalog:",
    "react-native-reanimated": "catalog:native",
    "react-native-safe-area-context": "catalog:native",
    "react-native-screens": "catalog:native",
    "react-native-svg": "catalog:native",
    "react-native-webview": "catalog:native",
    "react-native-worklets": "catalog:native",
    "tailwind-merge": "catalog:native",
    "tailwind-variants": "catalog:runtime",
    "tw-animate-css": "catalog:native",
    "uniwind": "catalog:native",
    "valtio-define": "catalog:runtime"
  },
  "devDependencies": {
    "@types/react": "catalog:types",
    "@types/react-test-renderer": "catalog:types",
    "react-test-renderer": "catalog:native",
    "typescript": "catalog:cli",
    "vitest": "catalog:testing"
  }
}
