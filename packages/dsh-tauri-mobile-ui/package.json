{
  "name": "dsh-tauri-mobile-ui",
  "type": "module",
  "version": "0.1.0",
  "description": "DSH Tauri 移动端界面适配。",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/deepseek-harness-desktop.git"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "dsh-tauri",
        "dsh-tauri-ui"
      ],
      "external": [
        "dsh-tauri/client",
        "dsh-tauri-ui/client"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "dsh-tauri": "workspace:*",
    "dsh-tauri-ui": "workspace:*"
  },
  "devDependencies": {
    "dsh-tauri-tsdown": "workspace:*",
    "react": "catalog:runtime",
    "tsdown": "catalog:cli"
  }
}
