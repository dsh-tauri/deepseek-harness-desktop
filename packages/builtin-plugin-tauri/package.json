{
  "name": "dsh-tauri",
  "type": "module",
  "version": "1.0.0",
  "description": "DeepSeek Harness 桌面壳的消息与原生功能桥接插件。",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/dsh-tauri-plugins.git"
  },
  "bugs": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "tauri",
    "deepseek-harness",
    "bridge"
  ],
  "sideEffects": [
    "**/modules/valtio-define.ts"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "nr build",
    "start": "tsx src/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:tauri",
    "dsh-h3": "catalog:",
    "h3": "catalog:",
    "hookable": "catalog:utils",
    "ofetch": "catalog:utils",
    "unstorage": "catalog:utils"
  },
  "devDependencies": {
    "@reause/core": "catalog:runtime",
    "@types/lodash-es": "catalog:types",
    "css-render": "catalog:ui",
    "date-fns": "catalog:utils",
    "dsh-tauri-config": "workspace:*",
    "lodash-es": "catalog:utils",
    "react-if-lite": "catalog:runtime",
    "tailwind-variants": "catalog:runtime",
    "tsdown": "catalog:cli",
    "valtio": "catalog:",
    "valtio-define": "catalog:runtime"
  }
}
