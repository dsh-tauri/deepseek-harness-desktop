{
  "name": "dsh-tauri-model",
  "type": "module",
  "version": "1.0.0",
  "description": "DeepSeek Harness 桌面壳的模型选择与参数配置。",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-tauri-desk/dsh-tauri-plugins.git"
  },
  "bugs": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "tauri",
    "deepseek-harness",
    "models",
    "model-capabilities",
    "vision"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "dsh-tauri",
        "dsh-tauri-ui"
      ],
      "external": [
        "dsh-tauri/client",
        "dsh-tauri-ui/client"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "nr build",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dsh-h3": "catalog:",
    "dsh-tauri": "workspace:*",
    "dsh-tauri-ui": "workspace:*",
    "h3": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-store": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-util-values": "catalog:dsh",
    "@types/node": "catalog:types",
    "dsh-tauri-tsdown": "workspace:*",
    "tsdown": "catalog:cli",
    "vitest": "catalog:testing"
  }
}
